{
  "name": "thadeus",
  "productName": "THADEUS",
  "version": "0.2.12",
  "private": true,
  "description": "T.H.A.D.E.U.S. (Transformative Human-AI Development Environment for Ubiquitous Systems): bridge console for AI-DLC projects with read-only visualisation and an embedded Claude terminal",
  "author": {
    "name": "Auctum Solutions AB",
    "email": "info@auctum.se"
  },
  "homepage": "https://github.com/tochman/ai-dlc-thadeus",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/third-party-licenses.mjs && electron-builder --mac",
    "test": "vitest run tests/",
    "coverage": "vitest run tests/ --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon": "electron scripts/make-icon.cjs",
    "screenshots": "electron-vite build && electron scripts/screenshots.cjs",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-pty-perms.cjs",
    "build:mac": "electron-vite build && node scripts/third-party-licenses.mjs && electron-builder --mac",
    "build:linux": "electron-vite build && node scripts/third-party-licenses.mjs && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@tanstack/react-virtual": "3.14.24",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "i18next": "^27.1.1",
    "i18next-icu": "^2.7.0",
    "intl-messageformat": "^12.1.5",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.18",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  },
  "license": "MIT"
}
